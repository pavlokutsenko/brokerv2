<UserControl x:Class="PriceCheck.Collector.LaunchTemplatesView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:PriceCheck.Collector"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}">
    <UserControl.Resources><ui:RussianUiTextConverter x:Key="RussianText"/></UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,10">
            <Grid>
                <TextBlock Text="Общие шаблоны запуска" FontSize="22" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="ScanStatusText" Foreground="{StaticResource MutedBrush}" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Content="Сканировать ПК" Click="Scan_Click"/>
                </StackPanel>
            </Grid>
            <TextBlock Text="Шаблоны доступны всем профилям. Выберите шаблон в каждом профиле; изменения применятся при следующем запуске."
                       Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ListBox x:Name="TemplateList" ItemsSource="{Binding Templates}" SelectionChanged="TemplateList_SelectionChanged"
                         Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}">
                    <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}"/></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="NewTemplateButton" Content="+ Новый" Click="New_Click"/>
                    <Button x:Name="DeleteTemplateButton" Content="Удалить" Margin="8,0,0,0" Click="Delete_Click"/>
                </StackPanel>
            </Grid>
            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="18">
                <Grid>
                <StackPanel x:Name="EmptyTemplatesPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedItem, ElementName=TemplateList}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Создайте шаблон для настройки HWID и прокси." TextWrapping="Wrap" TextAlignment="Center"/>
                    <Button x:Name="CreateTemplateButton" Content="+ Новый шаблон" Click="New_Click" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                </StackPanel>
                <ScrollViewer x:Name="EditorScroll" VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedItem, ElementName=TemplateList}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel x:Name="Editor">
                        <TextBlock Text="НАЗВАНИЕ ШАБЛОНА" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                        <TextBox x:Name="TemplateNameInput" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,6"/>
                        <TextBlock Text="ОПИСАНИЕ" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8"/>
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,6,0,14">
                            <StackPanel>
                                <CheckBox x:Name="ProxyToggle" Content="Использовать HTTP-прокси с авторизацией"
                                          IsChecked="{Binding ProxyEnabled, Mode=TwoWay}" FontWeight="SemiBold"/>
                                <TextBlock Text="Необязательно. У каждого запущенного клиента свой прокси-маршрут."
                                           Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,10"/>
                                <StackPanel x:Name="ProxyFields" IsEnabled="{Binding IsChecked, ElementName=ProxyToggle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="108"/></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,8,0"><TextBlock Text="ХОСТ" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                                            <TextBox x:Name="ProxyHostInput" Text="{Binding ProxyHost, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/></StackPanel>
                                        <StackPanel Grid.Column="1"><TextBlock Text="ПОРТ" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                                            <TextBox x:Name="ProxyPortInput" Text="{Binding ProxyPort, UpdateSourceTrigger=LostFocus}" Margin="0,4,0,0"/></StackPanel>
                                    </Grid>
                                    <Grid Margin="0,9,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,8,0"><TextBlock Text="ЛОГИН" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                                            <TextBox x:Name="ProxyUserInput" Text="{Binding ProxyUser, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/></StackPanel>
                                        <StackPanel Grid.Column="1"><TextBlock Text="ПАРОЛЬ" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                                            <PasswordBox x:Name="TemplatePassword" PasswordChanged="TemplatePassword_Changed" Margin="0,4,0,0"/></StackPanel>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="АППАРАТНЫЕ ИДЕНТИФИКАТОРЫ" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,8"/>
                        <CheckBox x:Name="HardwareToggle" Content="Подменять аппаратные идентификаторы" IsChecked="{Binding HardwareEnabled}" Margin="0,0,0,5"/>
                        <CheckBox x:Name="RotateIdentityToggle" Content="Создавать новые идентификаторы при каждом запуске"
                                  IsChecked="{Binding RotateEachLaunch}" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,9">
                            <TextBlock Text="СОЗДАННЫЕ ЗНАЧЕНИЯ" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                            <Button Content="↻ Создать заново" HorizontalAlignment="Right" Click="Regenerate_Click"/>
                        </Grid>
                        <TextBlock Text="При ротации показаны значения последнего запуска."
                                   Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,8"/>
                        <TextBlock Text="Строки SMBIOS сохраняют исходную длину. MAC служит базовым значением для сетевых адаптеров."
                                   Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,8"/>
                        <Expander Header="Показать 23 созданных идентификатора" Foreground="{StaticResource TextBrush}" IsExpanded="False">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                <RowDefinition/><RowDefinition/><RowDefinition/>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="System UUID · SMBIOS" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding Identity.SystemUuid}" IsReadOnly="True" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Text="MachineGuid · реестр" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Identity.MachineGuid}" IsReadOnly="True" Margin="0,2"/>
                            <TextBlock Grid.Row="2" Text="Серийный номер платы" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Identity.BoardSerial}" IsReadOnly="True" Margin="0,2"/>
                            <TextBlock Grid.Row="3" Text="Серийный номер тома" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Identity.VolumeSerial}" IsReadOnly="True" Margin="0,2"/>
                            <TextBlock Grid.Row="4" Text="MAC · адаптеры" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Identity.MacAddress}" IsReadOnly="True" Margin="0,2"/>
                            <TextBlock Grid.Row="5" Text="Серийный номер системы" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Identity.SystemSerial}" IsReadOnly="True" Margin="0,2"/>
                            <TextBlock Grid.Row="6" Text="Серийный номер корпуса" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Identity.ChassisSerial}" IsReadOnly="True" Margin="0,2"/>
                            <TextBlock Grid.Row="7" Text="ID процессора" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding Identity.ProcessorId}" IsReadOnly="True" Margin="0,2"/>
                            <TextBlock Grid.Row="8" Text="Серийный номер процессора" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding Identity.ProcessorSerial}" IsReadOnly="True" Margin="0,2"/>
                            <TextBlock Grid.Row="9" Text="Серийный номер памяти" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding Identity.MemorySerial}" IsReadOnly="True" Margin="0,2"/>
                            <TextBlock Grid.Row="10" Text="Серийный номер диска" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding Identity.DiskSerial}" IsReadOnly="True" Margin="0,2"/>
                            <TextBlock Grid.Row="11" Text="HwProfileGuid" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="11" Grid.Column="1" Text="{Binding Identity.HardwareProfileGuid}" IsReadOnly="True" Margin="0,2"/>
                            <TextBlock Grid.Row="12" Text="Windows ProductId" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="12" Grid.Column="1" Text="{Binding Identity.WindowsProductId}" IsReadOnly="True" Margin="0,2"/>
                            <TextBlock Grid.Row="13" Text="Диск · GPT GUID" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="13" Grid.Column="1" Text="{Binding Identity.DiskGuid}" IsReadOnly="True" Margin="0,2"/>
                            <TextBlock Grid.Row="14" Text="Диск · MBR ID" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="14" Grid.Column="1" Text="{Binding Identity.DiskSignature}" IsReadOnly="True" Margin="0,2"/>
                            <TextBlock Grid.Row="15" Text="Windows · SusClientId" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="15" Grid.Column="1" Text="{Binding Identity.SusClientId}" IsReadOnly="True" Margin="0,2"/>
                            <TextBlock Grid.Row="16" Text="Видео · реестр" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="16" Grid.Column="1" Text="{Binding Identity.VideoIdentifier}" IsReadOnly="True" Margin="0,2"/>
                            <TextBlock Grid.Row="17" Text="Имя ПК · реестр" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="17" Grid.Column="1" Text="{Binding Identity.RegistryComputerName}" IsReadOnly="True" Margin="0,2"/>
                            <TextBlock Grid.Row="18" Text="Дата установки · Unix" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="18" Grid.Column="1" Text="{Binding Identity.InstallDate}" IsReadOnly="True" Margin="0,2"/>
                            <TextBlock Grid.Row="19" Text="MAC шлюза · SendARP" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="19" Grid.Column="1" Text="{Binding Identity.RouterMac}" IsReadOnly="True" Margin="0,2"/>
                            <TextBlock Grid.Row="20" Text="Модель процессора · реестр" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="20" Grid.Column="1" Text="{Binding Identity.ProcessorModel}" IsReadOnly="True" Margin="0,2"/>
                            <TextBlock Grid.Row="21" Text="Ревизия процессора · реестр" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="21" Grid.Column="1" Text="{Binding Identity.ProcessorRevision}" IsReadOnly="True" Margin="0,2"/>
                            <TextBlock Grid.Row="22" Text="SQM MachineId · реестр" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="22" Grid.Column="1" Text="{Binding Identity.SqmMachineId}" IsReadOnly="True" Margin="0,2"/>
                        </Grid>
                        </Expander>
                        <Separator Margin="0,16,0,12"/>
                        <Expander x:Name="ScanDetails" Header="Найдено на этом ПК · сканирование по запросу"
                                  Foreground="{StaticResource TextBrush}" IsExpanded="False">
                        <StackPanel>
                        <TextBlock Text="Исходные значения читаются локально и не сохраняются в шаблоне. Покрытие показывает, что агент может подменить."
                                   Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,8"/>
                        <ItemsControl ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=ScanRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,7">
                                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label, Converter={StaticResource RussianText}}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding CurrentValue}" TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentValue}"/>
                                                 <TextBlock Text="{Binding TargetValue, StringFormat='Значение шаблона: {0}'}"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding TargetValue}" FontSize="11" Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding Coverage, Converter={StaticResource RussianText}}" FontSize="10" Foreground="{StaticResource PrimaryBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Отменить изменения" Click="Reset_Click"/>
            <Button x:Name="SaveTemplatesButton" Content="Сохранить шаблоны" Margin="10,0,0,0" Background="{StaticResource PrimaryBrush}"
                    Foreground="#07110D" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
