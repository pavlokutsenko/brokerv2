<Window x:Class="PriceCheck.Collector.AccountEditorDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Аккаунт" Width="460" Height="530" MinWidth="430" MinHeight="500"
 WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBrush}"
 TextElement.Foreground="{StaticResource TextBrush}">
 <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel Margin="20">
   <TextBlock Text="Аккаунт сервера" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,18"/>
   <TextBlock Text="ЛОГИН" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
   <TextBox x:Name="LoginInput" Margin="0,5,0,13"/>
   <TextBlock Text="ПАРОЛЬ" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
   <TextBox x:Name="PasswordInput" Margin="0,5,0,13"/>
   <TextBlock Text="ШАБЛОН ЗАПУСКА" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
   <ComboBox x:Name="TemplateInput" SelectedValuePath="Id" DisplayMemberPath="Name" Margin="0,5,0,13"/>
   <CheckBox x:Name="AutoLoginInput" Content="Автовход" Margin="0,0,0,12"
             Checked="AutoLogin_Changed" Unchecked="AutoLogin_Changed"/>
   <Grid Margin="0,0,0,14">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,8,0">
     <TextBlock Text="СЛОТ ПЕРСОНАЖА · 0–6" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
     <TextBox x:Name="CharacterSlotInput" Margin="0,5,0,0"/>
    </StackPanel>
    <CheckBox Grid.Column="1" x:Name="AutoRestartInput" Content="Перезапуск при сбое" VerticalAlignment="Bottom"/>
   </Grid>
   <CheckBox x:Name="RotationInput" Content="Ротация персонажей этого аккаунта" Margin="0,0,0,10"/>
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,8,0">
     <TextBlock Text="ИНТЕРВАЛ · МИН" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
     <TextBox x:Name="IntervalInput" Margin="0,5,0,0"/>
    </StackPanel>
    <StackPanel Grid.Column="1">
     <TextBlock Text="РАЗБРОС ± МИН" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
     <TextBox x:Name="JitterInput" Margin="0,5,0,0"/>
    </StackPanel>
   </Grid>
   <TextBlock Text="Для создания персонажей вручную оставьте автовход выключенным. Ротация требует автовход."
              Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,13,0,0"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
    <Button Content="Отмена" Click="Cancel_Click" MinWidth="85" Margin="0,0,8,0"/>
    <Button Content="Сохранить" Click="Save_Click" MinWidth="95" Background="{StaticResource PrimaryBrush}" Foreground="#07110D"/>
   </StackPanel>
  </StackPanel>
 </ScrollViewer>
</Window>
