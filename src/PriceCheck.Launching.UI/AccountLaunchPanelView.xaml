<UserControl x:Class="PriceCheck.Collector.AccountLaunchPanelView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:launch="clr-namespace:PriceCheck.Collector"
 TextElement.Foreground="{StaticResource TextBrush}">
 <UserControl.Resources><launch:RussianUiTextConverter x:Key="RussianText"/></UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="8,10,8,16">
   <TextBlock Text="Аккаунты" FontSize="25" FontWeight="SemiBold"/>
   <TextBlock Text="{Binding SelectedRuntime.Profile.Name, TargetNullValue=Выберите сервер}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,18"/>
   <Grid Margin="0,0,0,18">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="Клиент сервера" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <Button Grid.Column="1" Content="Добавить аккаунт" Click="AddAccount_Click" IsEnabled="{Binding SelectedRuntime.CanEditMarket}"
            Background="{StaticResource PrimaryBrush}" Foreground="#07110D"/>
   </Grid>
   <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
    <StackPanel>
     <TextBlock Text="ИСПОЛНЯЕМЫЙ ФАЙЛ" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,0,0,6"/>
     <DockPanel>
      <Button DockPanel.Dock="Right" Content="Обзор…" Click="BrowseFolder_Click" Margin="8,0,0,0"/>
      <TextBox Text="{Binding SelectedRuntime.Profile.LaunchFile, UpdateSourceTrigger=PropertyChanged}" TextChanged="ProfileField_Changed"/>
     </DockPanel>
    </StackPanel>
   </Border>
   <ItemsControl x:Name="AccountsList" ItemsSource="{Binding AccountItems}">
    <ItemsControl.ItemTemplate>
     <DataTemplate>
      <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,9">
       <StackPanel>
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding Runtime.Profile.LoginName}" FontSize="17" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding TemplateName}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
         </StackPanel>
         <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Content="Запустить" Tag="{Binding Runtime}" Click="LaunchAccount_Click" Background="{StaticResource PrimaryBrush}" Foreground="#07110D" Margin="0,0,8,0">
           <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="IsEnabled" Value="False"/>
            <Style.Triggers><DataTrigger Binding="{Binding Runtime.Session}" Value="{x:Null}"><Setter Property="IsEnabled" Value="True"/></DataTrigger></Style.Triggers>
           </Style></Button.Style>
          </Button>
          <Button Content="Остановить" Tag="{Binding Runtime}" Click="StopAccount_Click" Margin="0,0,8,0">
           <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="IsEnabled" Value="True"/>
            <Style.Triggers><DataTrigger Binding="{Binding Runtime.Session}" Value="{x:Null}"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers>
           </Style></Button.Style>
          </Button>
          <Button Content="Настроить" Tag="{Binding Runtime}" Click="EditAccount_Click" Margin="0,0,8,0"
                  IsEnabled="{Binding DataContext.SelectedRuntime.CanEditMarket, RelativeSource={RelativeSource AncestorType=Window}}"/>
          <Button Content="×" FontSize="17" Width="35" Padding="0" ToolTip="Удалить аккаунт" Tag="{Binding Runtime}" Click="DeleteAccount_Click"
                  IsEnabled="{Binding DataContext.SelectedRuntime.CanEditMarket, RelativeSource={RelativeSource AncestorType=Window}}"/>
         </StackPanel>
        </Grid>
        <TextBlock Text="{Binding Runtime.LaunchStatus, Converter={StaticResource RussianText}}" Foreground="{StaticResource MutedBrush}" Margin="0,11,0,0" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding Runtime.Protection.HardwareLabel}" Foreground="#E6B75A" Margin="0,5,0,0" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding Runtime.Protection.ProxyLabel}" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
       </StackPanel>
      </Border>
     </DataTemplate>
    </ItemsControl.ItemTemplate>
   </ItemsControl>
   <TextBlock Text="Аккаунтов пока нет. Добавьте первый, выберите его шаблон и запустите клиент." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0">
    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
     <Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=AccountsList}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
    </Style></TextBlock.Style>
   </TextBlock>
   <TextBlock Text="Запуск клиента не включает сбор. Для ручного входа и создания персонажей выключите автовход в настройках аккаунта."
              Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,14,0,0"/>
   <Button Content="Шаблоны запуска" Click="ManageTemplates_Click" HorizontalAlignment="Left" Margin="0,14,0,0"/>
  </StackPanel>
 </ScrollViewer>
</UserControl>
