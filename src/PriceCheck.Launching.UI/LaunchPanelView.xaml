<UserControl x:Class="PriceCheck.Collector.LaunchPanelView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="clr-namespace:PriceCheck.Collector" TextElement.Foreground="{StaticResource TextBrush}">
 <UserControl.Resources><ui:RussianUiTextConverter x:Key="RussianText"/></UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="8,10,8,6" DataContext="{Binding SelectedRuntime}">
   <TextBlock Text="Запуск и ротация" FontSize="25" FontWeight="SemiBold"/>
   <TextBlock Text="Настройки клиента и входа в игру" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,20"/>
   <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="16">
    <StackPanel>
     <DockPanel Margin="0,0,0,18">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
       <Button Content="Запустить клиент" Click="Launch_Click" Background="{StaticResource PrimaryBrush}" Foreground="#07110D" Margin="0,0,10,0"/>
       <Button Content="Остановить клиент" Click="Stop_Click" ToolTip="Останавливает только клиент этого профиля."/>
      </StackPanel>
      <StackPanel><TextBlock Text="{Binding Profile.Name, TargetNullValue=Выберите профиль}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding LaunchStatus, Converter={StaticResource RussianText}}" Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}"/></StackPanel>
     </DockPanel>
     <Border Background="#0E131A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
             CornerRadius="7" Padding="11" Margin="0,0,0,12" ToolTip="{Binding Protection.Detail, Converter={StaticResource RussianText}}">
      <StackPanel>
        <TextBlock x:Name="HardwareProtectionIndicator" Text="{Binding Protection.HardwareLabel}" FontWeight="SemiBold" TextWrapping="Wrap">
        <TextBlock.Style><Style TargetType="TextBlock">
         <Setter Property="Foreground" Value="#E6B75A"/>
         <Style.Triggers>
          <DataTrigger Binding="{Binding Protection.WorldIdentityApplied}" Value="True"><Setter Property="Foreground" Value="#65D4A6"/></DataTrigger>
          <DataTrigger Binding="{Binding Protection.Failed}" Value="True"><Setter Property="Foreground" Value="#FF7B7B"/></DataTrigger>
         </Style.Triggers>
        </Style></TextBlock.Style>
       </TextBlock>
        <TextBlock x:Name="ProxyProtectionIndicator" Text="{Binding Protection.ProxyLabel}" Margin="0,6,0,0" FontWeight="SemiBold" TextWrapping="Wrap">
        <TextBlock.Style><Style TargetType="TextBlock">
         <Setter Property="Foreground" Value="#E6B75A"/>
         <Style.Triggers>
          <DataTrigger Binding="{Binding Protection.ProxyReady}" Value="True"><Setter Property="Foreground" Value="#65D4A6"/></DataTrigger>
          <DataTrigger Binding="{Binding Protection.Failed}" Value="True"><Setter Property="Foreground" Value="#FF7B7B"/></DataTrigger>
          <DataTrigger Binding="{Binding Protection.ProxyRequired}" Value="False"><Setter Property="Foreground" Value="#8F9CAB"/></DataTrigger>
         </Style.Triggers>
        </Style></TextBlock.Style>
       </TextBlock>
       <TextBlock Text="{Binding Protection.Detail, Converter={StaticResource RussianText}}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                  FontSize="11" Margin="0,7,0,0"/>
      </StackPanel>
     </Border>
     <TextBlock Text="Исполняемый файл клиента" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,6"/>
     <DockPanel><Button DockPanel.Dock="Right" Content="Обзор…" Click="BrowseFolder_Click" Margin="8,0,0,0"/><TextBox Text="{Binding Profile.LaunchFile, UpdateSourceTrigger=PropertyChanged}" TextChanged="ProfileField_Changed"/></DockPanel>
                    <Border  Background="#0E131A" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="7" Padding="11" Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="240" />
                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ШАБЛОН ЗАПУСКА" Foreground="{StaticResource MutedBrush}" FontSize="10"
                                       VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=LaunchTemplates}"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding Profile.LaunchTemplateId, Mode=TwoWay}"
                                      SelectionChanged="LaunchTemplateSelection_Changed">
                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" Foreground="#11161E"/></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="2" Content="Общие шаблоны" Click="ManageTemplates_Click" Margin="10,0,16,0"/>
                            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                <TextBlock Text="HWID и прокси берутся из выбранного шаблона" TextWrapping="Wrap" FontSize="11"/>
                                <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=SelectedTemplateSummary}"
                                           Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border  Background="#0E131A" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="7" Padding="11" Margin="0,8,0,0">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="1.5*" /><ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Content="Автовход" IsChecked="{Binding Profile.AutoLoginEnabled, Mode=TwoWay}"
                                      Checked="AutoLogin_Changed" Unchecked="AutoLogin_Changed"
                                      VerticalAlignment="Center" Margin="0,0,18,0"/>
                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock Text="ЛОГИН" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                                <TextBox Text="{Binding Profile.LoginName, UpdateSourceTrigger=PropertyChanged}"
                                         TextChanged="ProfileField_Changed" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                <TextBlock Text="ПАРОЛЬ" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                                <PasswordBox x:Name="LoginPasswordBox" x:FieldModifier="public" PasswordChanged="LoginPassword_Changed" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Margin="0,0,10,0">
                                <TextBlock Text="СЕРВЕР" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                                <ComboBox ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Runtimes}"
                                          DisplayMemberPath="Profile.Name"
                                          SelectedItem="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=SelectedRuntime, Mode=TwoWay}"
                                          Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4" Margin="0,0,10,0">
                                <TextBlock Text="ПЕРСОНАЖ" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                                <ComboBox ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=CharacterOptions}"
                                          DisplayMemberPath="Label" SelectedValuePath="Slot"
                                          SelectedValue="{Binding Profile.CharacterSlot, Mode=TwoWay}"
                                          SelectionChanged="ProfileSelection_Changed" Margin="0,4,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Grid.ColumnSpan="5" Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedBrush}"
                                       Text="Выбор профиля переключает сервер и аккаунт. Кнопка + добавляет Gamma, Black, White или Carmine. Нумерация персонажей начинается с 0; пароли защищены Windows DPAPI."/>
                        </Grid>
                    </Border>
                    <Border Background="#0E131A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="11" Margin="0,8,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                                <CheckBox x:Name="RotationToggle" Content="Ротация персонажей" IsChecked="{Binding Profile.CharacterRotationEnabled, Mode=TwoWay}"
                                          Checked="AutoLogin_Changed" Unchecked="AutoLogin_Changed" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                    <TextBlock Text="ИНТЕРВАЛ · МИН" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                                    <TextBox x:Name="RotationIntervalInput" Text="{Binding Profile.RotationIntervalMinutes, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" TextChanged="ProfileField_Changed" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="РАЗБРОС ± МИН" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                                    <TextBox x:Name="RotationJitterInput" Text="{Binding Profile.RotationJitterMinutes, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" TextChanged="ProfileField_Changed" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Все занятые слоты каждого аккаунта по кругу. При каждой смене клиент перезапускается. Требуется автовход."
                                       TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,9,0,0"/>
                            <DockPanel Margin="0,10,0,0">
                                <Button x:Name="RotationAccountsButton" DockPanel.Dock="Left" Content="Аккаунты ротации…"
                                        Click="RotationAccounts_Click" IsEnabled="{Binding CanEditMarket}"/>
                                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}">
                                    <Run Text="Всего: "/><Run Text="{Binding Profile.RotationAccountCount, Mode=OneWay}"/>
                                </TextBlock>
                            </DockPanel>
                            <TextBlock Text="{Binding CharacterRotationStatus, Converter={StaticResource RussianText}}" TextWrapping="Wrap" Foreground="{StaticResource PrimaryBrush}" FontSize="11" Margin="0,7,0,0"/>
                        </StackPanel>
                    </Border>
                    <CheckBox x:Name="AutoRestartToggle" Content="Перезапуск при отключении или сбое клиента" IsChecked="{Binding Profile.AutoRestartEnabled, Mode=TwoWay}"
                              Checked="AutoLogin_Changed" Unchecked="AutoLogin_Changed" Margin="0,12,0,0"/>
    </StackPanel>
   </Border>
   <TextBlock Text="Перед запуском выберите шаблон HWID. Прокси используется, только если включён в шаблоне." TextWrapping="Wrap" Margin="0,18,0,0" Foreground="{StaticResource MutedBrush}"/>
   <TextBlock Text="При закрытии приложения запущенные им клиенты и их прокси-соединения останавливаются." TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}"/>
  </StackPanel>
 </ScrollViewer>
</UserControl>


