<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>PriceCheck.Collector</AssemblyName>
    <RootNamespace>PriceCheck.Collector</RootNamespace>
    <ApplicationManifest>..\PriceCheck.Windows\desktop.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="..\PriceCheck.Launching.UI\PriceCheck.Launching.UI.csproj" /><ProjectReference Include="..\PriceCheck.Collection\PriceCheck.Collection.csproj" /></ItemGroup>
  <ItemGroup>
    <Content Include="BrokerRuntime\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\maps\**\city.json" Link="Maps\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Import Project="..\..\native\ClientLaunch\Runtime.props" />
</Project>
