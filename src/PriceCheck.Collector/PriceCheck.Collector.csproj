<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>PriceCheck.Collector</AssemblyName>
    <RootNamespace>PriceCheck.Collector</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="BrokerRuntime\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\native\LU4Memory\artifacts\verified\lu4_memory.sys"
             Link="DriverRuntime\lu4_memory.sys"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\native\LU4Memory\loader\**\*"
             Link="DriverRuntime\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
