<UserControl x:Class="PriceCheck.Collector.CollectionPanelView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:PriceCheck.Collector.Controls">        <Grid Margin="8,10,8,6" DataContext="{Binding SelectedRuntime}"
              TextElement.Foreground="{StaticResource TextBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Character and prices" FontSize="25" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
                    <TextBlock Text="Connect before world entry for a complete initial radar; late connections receive new scene updates."
                               TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,5,12,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Connect reader" Background="{StaticResource PrimaryBrush}" Foreground="#07110D"
                            BorderBrush="{StaticResource PrimaryBrush}" FontWeight="SemiBold" Click="AttachReader_Click" /><Button Content="Disconnect reader" Click="DetachReader_Click" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="9" Padding="16" Margin="0,16,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.85*" />
                        <ColumnDefinition Width="0.75*" />
                        <ColumnDefinition Width="1.7*" />
                        <ColumnDefinition Width="0.65*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="Market" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,6" />
                        <ComboBox IsEditable="True"
                                  ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=MarketOptions}"
                                  Text="{Binding Profile.Name, UpdateSourceTrigger=PropertyChanged}"
                                  SelectionChanged="ProfileSelection_Changed">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="#11161E" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,14,0">
                        <TextBlock Text="City" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=CityOptions}"
                                  SelectedItem="{Binding Profile.City, Mode=TwoWay}" SelectionChanged="ProfileSelection_Changed">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="#11161E" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Grid.ColumnSpan="2" Margin="0,0,14,0">
                        <TextBlock Text="Existing client for an unbound profile" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=AvailableClients}" DisplayMemberPath="Label" SelectedItem="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=SelectedClient, Mode=TwoWay}"/>
                    </StackPanel>                    <Button Grid.Column="4" Content="Refresh list" VerticalAlignment="Bottom" Click="RefreshClients_Click" />
                    <Border Grid.Row="1" Grid.ColumnSpan="5" Background="#0E131A" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="7" Padding="11" Margin="0,14,0,0">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="CENTER ZONE · RADIUS 500" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                                <TextBlock Text="{Binding CenterZoneLabel}" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding CurrentPositionLabel}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0"/>
                                <TextBlock Text="{Binding CenterZoneState}" Foreground="{StaticResource PrimaryBrush}" FontSize="11" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Set current" Click="MarkCenterZone_Click" Margin="8,0,0,0"/>
                            <Button Grid.Column="2" Content="Clear" Click="ClearCenterZone_Click" Margin="8,0,0,0"/>
                            <Button Grid.Column="3" Content="{Binding CollectionToggleLabel}" Background="{StaticResource PrimaryBrush}" Foreground="#07110D"
                                    BorderBrush="{StaticResource PrimaryBrush}" FontWeight="SemiBold" Click="ToggleCollection_Click" Margin="18,0,0,0"/>
                            <DockPanel Grid.Row="1" Grid.ColumnSpan="4" Margin="0,12,0,0">
                                <TextBlock DockPanel.Dock="Left" Text="API SERVER" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBox Text="{Binding Profile.ServerUrl, UpdateSourceTrigger=PropertyChanged}" TextChanged="ProfileField_Changed"/>
                            </DockPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <UniformGrid Grid.Row="2" Columns="7" Margin="0,0,0,16">
                <Border Style="{x:Null}" Background="{StaticResource CardBrush}" CornerRadius="8" Padding="13" Margin="0,0,8,0">
                    <StackPanel><TextBlock Text="KNOWN / VISIBLE" Foreground="{StaticResource MutedBrush}" FontSize="10" /><TextBlock Text="{Binding RadarTraderCount}" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel>
                </Border>
                <Border Background="{StaticResource CardBrush}" CornerRadius="8" Padding="13" Margin="0,0,8,0">
                    <StackPanel><TextBlock Text="BROKER" Foreground="{StaticResource MutedBrush}" FontSize="10" /><TextBlock Text="{Binding BrokerTraderCount}" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel>
                </Border>
                <Border Background="{StaticResource CardBrush}" CornerRadius="8" Padding="13" Margin="0,0,8,0">
                    <StackPanel><TextBlock Text="SELLING" Foreground="{StaticResource MutedBrush}" FontSize="10" /><TextBlock Text="{Binding SellCount}" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel>
                </Border>
                <Border Background="{StaticResource CardBrush}" CornerRadius="8" Padding="13" Margin="0,0,8,0">
                    <StackPanel><TextBlock Text="BUYING" Foreground="{StaticResource MutedBrush}" FontSize="10" /><TextBlock Text="{Binding BuyCount}" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel>
                </Border>
                <Border Background="{StaticResource CardBrush}" CornerRadius="8" Padding="13" Margin="0,0,8,0">
                    <StackPanel><TextBlock Text="PACKETS" Foreground="{StaticResource MutedBrush}" FontSize="10" /><TextBlock Text="{Binding PackageCount}" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel>
                </Border>
                <Border Background="{StaticResource CardBrush}" CornerRadius="8" Padding="13" Margin="0,0,8,0">
                    <StackPanel><TextBlock Text="LISTINGS" Foreground="{StaticResource MutedBrush}" FontSize="10" /><TextBlock Text="{Binding ListingCount}" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel>
                </Border>
                <Border Background="{StaticResource CardBrush}" CornerRadius="8" Padding="13">
                    <StackPanel><TextBlock Text="ACTORS" Foreground="{StaticResource MutedBrush}" FontSize="10" /><TextBlock Text="{Binding ActorCount}" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel>
                </Border>
            </UniformGrid>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.25*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,14,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Market radar" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="  ● selling" Foreground="{StaticResource PrimaryBrush}" FontSize="11" Margin="14,2,0,0" />
                                <TextBlock Text="● buying" Foreground="#5EA8FF" FontSize="11" Margin="12,2,0,0" />
                                <TextBlock Text="● packages" Foreground="{StaticResource WarningBrush}" FontSize="11" Margin="12,2,0,0" />
                            </StackPanel>
                            <TextBlock Text="{Binding LastRadarLabel}" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                        </Grid>
                        <controls:RadarMapControl Grid.Row="1" Snapshot="{Binding Radar}" Margin="0,12,0,0" />
                    </Grid>
                </Border>
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Broker cycle" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding LastBrokerLabel}" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,12" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="70" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Interval, minutes" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding Profile.BrokerIntervalMinutes, UpdateSourceTrigger=PropertyChanged}" TextChanged="ProfileField_Changed" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="15">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock Text="Events" FontSize="15" FontWeight="SemiBold" />
                            <ListBox Grid.Row="1" ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Events}"
                                     Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="-4,8,-4,8" />
                            <Button Grid.Row="2" Content="Delete profile" Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Left" Click="DeleteProfile_Click" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
</UserControl>
