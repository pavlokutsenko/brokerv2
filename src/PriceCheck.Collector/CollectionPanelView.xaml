<UserControl x:Class="PriceCheck.Collector.CollectionPanelView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:PriceCheck.Collector.Controls"
 xmlns:ui="clr-namespace:PriceCheck.Collector;assembly=PriceCheck.Launching.UI">
 <UserControl.Resources><ui:RussianUiTextConverter x:Key="RussianText"/></UserControl.Resources>
 <Grid Margin="8,10,8,6" Background="{StaticResource WindowBrush}" DataContext="{Binding SelectedRuntime}" TextElement.Foreground="{StaticResource TextBrush}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,14">
   <Button DockPanel.Dock="Right" Content="{Binding CollectionToggleLabel}" Click="ToggleCollection_Click" Background="{StaticResource PrimaryBrush}" Foreground="#07110D"/>
   <StackPanel><TextBlock Text="Сбор рынка · Гиран" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="{Binding Cycle.Phase, Converter={StaticResource RussianText}}" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/></StackPanel>
  </DockPanel>
  <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="9" Padding="12" Margin="0,0,0,12">
   <StackPanel>
    <TextBlock x:Name="CharacterRotationCountdown" Text="{Binding CharacterRotationStatus, Converter={StaticResource RussianText}}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,8"/>
    <TextBlock Text="{Binding Cycle.Detail, Converter={StaticResource RussianText}}" TextWrapping="Wrap" Foreground="{StaticResource PrimaryBrush}"/>
    <TextBlock Text="{Binding UploadStatus, Converter={StaticResource RussianText}}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
    <WrapPanel Margin="0,8,0,0">
     <TextBlock Margin="0,0,24,4"><Run Text="Трейдеров в центре: "/><Run Text="{Binding CenterRadarTraderCount, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" · "/><Run Text="{Binding CenterRadarCountAge, Mode=OneWay}" Foreground="{StaticResource MutedBrush}"/></TextBlock>
     <TextBlock Margin="0,0,24,4"><Run Text="Радар сейчас: "/><Run Text="{Binding CurrentRadarTraderCount, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock>
     <TextBlock Margin="0,0,24,4"><Run Text="Последний брокер: "/><Run Text="{Binding BrokerTraderCount, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock>
     <TextBlock Margin="0,0,24,4"><Run Text="Отправлено с последнего брокера: "/><Run Text="{Binding BrokerSentTraderCount, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock>
     <TextBlock Margin="0,0,0,4"><Run Text="С актуальной ценой: "/><Run Text="{Binding Cycle.CurrentPriceTraders, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock>
    </WrapPanel>
    <TextBlock Margin="0,8,0,0"><Run Text="Текущий проход: прочитано "/><Run Text="{Binding Cycle.PassRead}"/><Run Text=" · новых "/><Run Text="{Binding Cycle.PassNewFound}"/><Run Text=" · осталось "/><Run Text="{Binding Cycle.Pending}"/></TextBlock>
   </StackPanel>
  </Border>
  <TabControl x:Name="CollectionTabs" Grid.Row="2" Background="Transparent" BorderThickness="0">
   <TabItem Header="Цели прохода">
    <DataGrid ItemsSource="{Binding Cycle.Queue}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
     EnableRowVirtualization="True" Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}"
     RowBackground="{StaticResource PanelBrush}" AlternatingRowBackground="{StaticResource CardBrush}" BorderThickness="0" GridLinesVisibility="None" Margin="0,10,0,0">
     <DataGrid.Columns><DataGridTextColumn Header="Трейдер" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Состояние" Binding="{Binding State, Converter={StaticResource RussianText}}" Width="130"/><DataGridTextColumn Header="Причина" Binding="{Binding Reason, Converter={StaticResource RussianText}}" Width="2*"/><DataGridTextColumn Header="Возраст цены" Binding="{Binding PriceAge, Converter={StaticResource RussianText}}" Width="120"/></DataGrid.Columns>
    </DataGrid>
   </TabItem>
   <TabItem Header="Новые цели радара">
    <DataGrid ItemsSource="{Binding Cycle.RadarQueue}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
     Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}" RowBackground="{StaticResource PanelBrush}" AlternatingRowBackground="{StaticResource CardBrush}" BorderThickness="0" GridLinesVisibility="None" Margin="0,10,0,0">
     <DataGrid.Columns><DataGridTextColumn Header="Трейдер" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Состояние" Binding="{Binding State, Converter={StaticResource RussianText}}" Width="*"/><DataGridTextColumn Header="Цена" Binding="{Binding PriceAge, Converter={StaticResource RussianText}}" Width="*"/></DataGrid.Columns>
    </DataGrid>
   </TabItem>
   <TabItem Header="Карта Гирана"><controls:RadarMapControl Snapshot="{Binding Radar}" City="{Binding Profile.City}" Margin="0,10,0,0"/></TabItem>
   <TabItem Header="Настройки сбора">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12" MaxWidth="760" HorizontalAlignment="Left">
       <TextBlock Text="Рынок совпадает с сервером выбранного профиля" Margin="0,0,0,6"/>
       <TextBlock Text="{Binding Profile.Name}" FontWeight="SemiBold"/>
       <TextBlock Text="Пауза после проверки трейдера, секунд" Margin="0,18,0,6"/>
       <TextBox Width="200" HorizontalAlignment="Left" Text="{Binding Profile.TraderPauseSeconds, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" TextChanged="ProfileField_Changed"/>
       <TextBlock Text="Повторная проверка через, часов" Margin="0,18,0,6"/>
     <TextBox Width="200" HorizontalAlignment="Left" Text="{Binding Profile.RecheckHours, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" TextChanged="ProfileField_Changed"/>
     <TextBlock Text="Новые позиции, переоткрытие, перемещение и смена типа требуют более ранней проверки. Изменение количества не требует подхода." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
     <TextBlock Text="Адрес сервера" Margin="0,18,0,6"/><TextBox Text="{Binding Profile.ServerUrl, UpdateSourceTrigger=PropertyChanged}" TextChanged="ProfileField_Changed"/>
     <TextBlock Text="Сохранённый центр · радиус 200" Margin="0,18,0,6"/><TextBlock Text="{Binding CenterZoneLabel}"/><TextBlock Text="{Binding CurrentPositionLabel}" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/><TextBlock Text="{Binding CenterZoneState}" Foreground="{StaticResource PrimaryBrush}" Margin="0,6,0,0"/>
     <TextBlock Text="Закрывшиеся лавки снимаются по свежему подтверждению или завершённой сверке радара из центра. Во время обхода потеря видимости ничего не снимает. История сохраняется." TextWrapping="Wrap" Margin="0,12,0,0"/>
     <TextBlock Text="{Binding CharacterRotationStatus, Converter={StaticResource RussianText}}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,18,0,0"/>
     <TextBlock Text="F8 останавливает движение. Неполный брокер оставляет прежние остатки и продолжает доступный обход." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0"/>
    </StackPanel></ScrollViewer>
   </TabItem>
  </TabControl>
 </Grid>
</UserControl>
