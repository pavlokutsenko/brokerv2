<UserControl x:Class="PriceCheck.Collector.CollectionPanelView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:PriceCheck.Collector.Controls">
 <Grid Margin="8,10,8,6" Background="{StaticResource WindowBrush}" DataContext="{Binding SelectedRuntime}" TextElement.Foreground="{StaticResource TextBrush}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,14">
   <Button DockPanel.Dock="Right" Content="{Binding CollectionToggleLabel}" Click="ToggleCollection_Click" Background="{StaticResource PrimaryBrush}" Foreground="#07110D"/>
   <StackPanel><TextBlock Text="Сбор рынка · Гиран" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="{Binding Cycle.Phase}" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/></StackPanel>
  </DockPanel>
  <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="9" Padding="12" Margin="0,0,0,12">
   <StackPanel>
    <TextBlock Text="{Binding Cycle.Detail}" TextWrapping="Wrap" Foreground="{StaticResource PrimaryBrush}"/>
    <TextBlock Text="{Binding UploadStatus}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
    <TextBlock Margin="0,8,0,0"><Run Text="Текущий проход: прочитано "/><Run Text="{Binding Cycle.PassRead}"/><Run Text=" · новых "/><Run Text="{Binding Cycle.PassNewFound}"/><Run Text=" · осталось "/><Run Text="{Binding Cycle.Pending}"/></TextBlock>
   </StackPanel>
  </Border>
  <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">
   <TabItem Header="Цели прохода">
    <DataGrid ItemsSource="{Binding Cycle.Queue}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
     EnableRowVirtualization="True" Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}"
     RowBackground="{StaticResource PanelBrush}" AlternatingRowBackground="{StaticResource CardBrush}" BorderThickness="0" GridLinesVisibility="None" Margin="0,10,0,0">
     <DataGrid.Columns><DataGridTextColumn Header="Трейдер" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Состояние" Binding="{Binding State}" Width="130"/><DataGridTextColumn Header="Причина" Binding="{Binding Reason}" Width="2*"/><DataGridTextColumn Header="Возраст цены" Binding="{Binding PriceAge}" Width="120"/></DataGrid.Columns>
    </DataGrid>
   </TabItem>
   <TabItem Header="Новые цели радара">
    <DataGrid ItemsSource="{Binding Cycle.RadarQueue}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
     Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}" RowBackground="{StaticResource PanelBrush}" AlternatingRowBackground="{StaticResource CardBrush}" BorderThickness="0" GridLinesVisibility="None" Margin="0,10,0,0">
     <DataGrid.Columns><DataGridTextColumn Header="Трейдер" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Состояние" Binding="{Binding State}" Width="*"/><DataGridTextColumn Header="Цена" Binding="{Binding PriceAge}" Width="*"/></DataGrid.Columns>
    </DataGrid>
   </TabItem>
   <TabItem Header="Карта Гирана"><controls:RadarMapControl Snapshot="{Binding Radar}" Margin="0,10,0,0"/></TabItem>
   <TabItem Header="Настройки сбора">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12" MaxWidth="760" HorizontalAlignment="Left">
     <TextBlock Text="Рынок" Margin="0,0,0,6"/>
     <ComboBox Width="200" HorizontalAlignment="Left" IsEnabled="{Binding CanEditMarket}" ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=MarketOptions}" SelectedItem="{Binding Profile.Name, Mode=TwoWay}" SelectionChanged="ProfileSelection_Changed"/>
     <TextBlock Text="Повторная проверка через, часов" Margin="0,18,0,6"/>
     <TextBox Width="200" HorizontalAlignment="Left" Text="{Binding Profile.RecheckHours, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" TextChanged="ProfileField_Changed"/>
     <TextBlock Text="Новые позиции, переоткрытие, перемещение и смена типа требуют более ранней проверки. Изменение количества не требует подхода." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
     <TextBlock Text="Адрес сервера" Margin="0,18,0,6"/><TextBox Text="{Binding Profile.ServerUrl, UpdateSourceTrigger=PropertyChanged}" TextChanged="ProfileField_Changed"/>
     <TextBlock Text="Сохранённый центр · радиус 500" Margin="0,18,0,6"/><TextBlock Text="{Binding CenterZoneLabel}"/><TextBlock Text="{Binding CurrentPositionLabel}" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/><TextBlock Text="{Binding CenterZoneState}" Foreground="{StaticResource PrimaryBrush}" Margin="0,6,0,0"/>
     <TextBlock Text="Снятие предложений разрешено только по свежему подтверждению закрытия из центральной зоны. Потеря видимости и отсутствие в брокере ничего не удаляют." TextWrapping="Wrap" Margin="0,12,0,0"/>
     <Expander Header="Подключить существующий клиент" Margin="0,18,0,0"><StackPanel Margin="0,8,0,0">
      <ComboBox ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=AvailableClients}" DisplayMemberPath="Label" SelectedItem="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=SelectedClient, Mode=TwoWay}"/>
      <WrapPanel Margin="0,8,0,0"><Button Content="Обновить" Click="RefreshClients_Click"/><Button Content="Подключить reader" Click="AttachReader_Click" Margin="8,0"/><Button Content="Отключить reader" Click="DetachReader_Click"/></WrapPanel>
     </StackPanel></Expander>
     <TextBlock Text="{Binding CharacterRotationStatus}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,18,0,0"/>
     <TextBlock Text="F8 останавливает движение. Неполный брокер оставляет прежние остатки и продолжает доступный обход." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0"/>
     <Button Content="Удалить профиль" Click="DeleteProfile_Click" Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Left" Margin="0,20,0,0"/>
    </StackPanel></ScrollViewer>
   </TabItem>
  </TabControl>
 </Grid>
</UserControl>
