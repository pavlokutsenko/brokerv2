<Window x:Class="PriceCheck.Collector.RotationAccountsDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Аккаунты ротации" Width="460" Height="470" MinWidth="420" MinHeight="420"
 WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBrush}"
 TextElement.Foreground="{StaticResource TextBrush}">
 <Grid Margin="18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,14">
   <TextBlock Text="Основной аккаунт" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
   <TextBlock x:Name="PrimaryName" FontWeight="SemiBold" Margin="0,4,0,0"/>
  </StackPanel>
  <Grid Grid.Row="1">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,6">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
     <Button Content="Новый" Click="New_Click" MinWidth="70" Margin="0,0,7,0"/>
     <Button Content="↑" Padding="0" FontFamily="Segoe UI Symbol" Foreground="{StaticResource TextBrush}" ToolTip="Выше в порядке ротации" Click="MoveUp_Click" Width="30" Margin="0,0,5,0"/>
     <Button Content="↓" Padding="0" FontFamily="Segoe UI Symbol" Foreground="{StaticResource TextBrush}" ToolTip="Ниже в порядке ротации" Click="MoveDown_Click" Width="30" Margin="0,0,7,0"/>
     <Button Content="Удалить" Click="Delete_Click" MinWidth="75"/>
    </StackPanel>
    <TextBlock Text="Дополнительные аккаунты" VerticalAlignment="Center"/>
   </DockPanel>
   <ListBox x:Name="AccountsList" Grid.Row="1" DisplayMemberPath="LoginName" SelectionChanged="AccountsList_SelectionChanged"
            Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"/>
  </Grid>
  <Grid Grid.Row="2" Margin="0,14,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <StackPanel Margin="0,0,8,0"><TextBlock Text="ЛОГИН" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
    <TextBox x:Name="LoginInput" Margin="0,4,0,0"/></StackPanel>
   <StackPanel Grid.Column="1"><TextBlock Text="НОВЫЙ ПАРОЛЬ" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
    <PasswordBox x:Name="PasswordInput" Margin="0,4,0,0"/></StackPanel>
  </Grid>
  <Button Grid.Row="3" x:Name="SaveAccountButton" Content="Добавить аккаунт" Click="SaveAccount_Click"
          HorizontalAlignment="Left" Margin="0,12,0,0" MinWidth="145"/>
  <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
   <Button Content="Отмена" Click="Cancel_Click" MinWidth="80" Margin="0,0,8,0"/>
   <Button Content="Готово" Click="Done_Click" MinWidth="90" Background="{StaticResource PrimaryBrush}" Foreground="#07110D"/>
  </StackPanel>
 </Grid>
</Window>
