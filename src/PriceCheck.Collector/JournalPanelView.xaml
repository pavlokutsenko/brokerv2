<UserControl x:Class="PriceCheck.Collector.JournalPanelView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="clr-namespace:PriceCheck.Collector;assembly=PriceCheck.Launching.UI">
 <UserControl.Resources><ui:RussianUiTextConverter x:Key="RussianText"/></UserControl.Resources>
 <Grid Margin="8,10" TextElement.Foreground="{StaticResource TextBrush}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <TextBlock FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12">
   <Run Text="Журнал · "/><Run Text="{Binding SelectedRuntime.Profile.Name}"/>
  </TextBlock>
  <WrapPanel Grid.Row="1" Margin="0,0,0,12">
   <ComboBox x:Name="LevelFilter" Width="115" SelectedIndex="0" SelectionChanged="FilterChanged" Margin="0,0,8,0">
    <ComboBoxItem Content="Все уровни"/><ComboBoxItem Content="Информация"/><ComboBoxItem Content="Предупреждение"/><ComboBoxItem Content="Ошибка"/>
   </ComboBox>
   <TextBox x:Name="Search" Width="230" TextChanged="FilterChanged" ToolTip="Поиск в журнале"/>
   <CheckBox x:Name="AutoScroll" Content="Автопрокрутка" IsChecked="True" VerticalAlignment="Center" Margin="12,0"/>
   <Button Content="Копировать" Click="Copy_Click" ToolTip="Выделенные записи; без выделения — все отфильтрованные"/>
  </WrapPanel>
  <DataGrid x:Name="Entries" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
   SelectionMode="Extended" EnableRowVirtualization="True" EnableColumnVirtualization="True"
   Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}" RowBackground="{StaticResource PanelBrush}"
   AlternatingRowBackground="{StaticResource CardBrush}" BorderThickness="0" GridLinesVisibility="None">
   <DataGrid.Columns>
    <DataGridTextColumn Header="Время" Binding="{Binding LocalTime}" Width="115"/>
    <DataGridTextColumn Header="Уровень" Binding="{Binding Level, Converter={StaticResource RussianText}}" Width="130"/>
    <DataGridTextColumn Header="Трейдер" Binding="{Binding Trader}" Width="110"/>
    <DataGridTextColumn Header="Событие" Binding="{Binding Message, Converter={StaticResource RussianText}}" Width="*"/>
   </DataGrid.Columns>
  </DataGrid>
 </Grid>
</UserControl>
