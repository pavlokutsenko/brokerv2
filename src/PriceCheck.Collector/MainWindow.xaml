<Window x:Class="PriceCheck.Collector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PriceCheck.Collector.Controls"
        Title="PriceCheck Collector" Width="1380" Height="840"
        MinWidth="1120" MinHeight="700" WindowStartupLocation="CenterScreen">
    <Grid Background="{StaticResource WindowBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="286" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#0E131A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="PRICECHECK" FontWeight="SemiBold" FontSize="17" />
                    <TextBlock Text="COLLECTOR" Foreground="{StaticResource PrimaryBrush}" FontWeight="Bold" FontSize="11" />
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,24,0,12">
                    <TextBlock Text="ЭКЗЕМПЛЯРЫ" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Content="+" Width="32" Height="30" Padding="0" HorizontalAlignment="Right" Click="AddProfile_Click" ToolTip="Добавить рынок" />
                </Grid>
                <ListBox Grid.Row="2" ItemsSource="{Binding Runtimes}" SelectedItem="{Binding SelectedRuntime}"
                         Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,8" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#17241F" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Background}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Profile.Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding ProcessLabel}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding RoleLabel}" Foreground="{StaticResource PrimaryBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="8,5,0,0" TextTrimming="CharacterEllipsis" MaxWidth="95" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="3" Margin="0,14,0,0">
                    <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,14" />
                    <TextBlock Text="Локальная машина" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                    <TextBlock Text="Профили запускаются независимо" FontSize="11" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="28,22,28,24" DataContext="{Binding SelectedRuntime}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Profile.Name, TargetNullValue=Выберите экземпляр}" FontSize="25" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Запустить клиент" Background="{StaticResource PrimaryBrush}" Foreground="#07110D"
                            BorderBrush="{StaticResource PrimaryBrush}" FontWeight="SemiBold" Click="Launch_Click" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="9" Padding="16" Margin="0,20,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.85*" />
                        <ColumnDefinition Width="0.75*" />
                        <ColumnDefinition Width="1.7*" />
                        <ColumnDefinition Width="0.65*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="Рынок" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,6" />
                        <ComboBox IsEditable="True"
                                  ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=MarketOptions}"
                                  Text="{Binding Profile.Name, UpdateSourceTrigger=PropertyChanged}"
                                  SelectionChanged="ProfileSelection_Changed">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="#11161E" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,14,0">
                        <TextBlock Text="Город" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=CityOptions}"
                                  SelectedItem="{Binding Profile.City, Mode=TwoWay}" SelectionChanged="ProfileSelection_Changed">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="#11161E" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,14,0">
                        <TextBlock Text="Файл запуска клиента" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding Profile.LaunchFile, UpdateSourceTrigger=PropertyChanged}" TextChanged="ProfileField_Changed" />
                            <Button Grid.Column="1" Content="…" Width="38" Padding="0" Margin="6,0,0,0" Click="BrowseFolder_Click" />
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="0,0,14,0">
                        <TextBlock Text="Роль" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=RoleOptions}"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding Profile.Role, Mode=TwoWay}" SelectionChanged="Role_Changed">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" Foreground="#11161E" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <Button Grid.Column="4" Content="Остановить" VerticalAlignment="Bottom" Click="Stop_Click" />
                </Grid>
            </Border>

            <UniformGrid Grid.Row="2" Columns="7" Margin="0,0,0,16">
                <Border Style="{x:Null}" Background="{StaticResource CardBrush}" CornerRadius="8" Padding="13" Margin="0,0,8,0">
                    <StackPanel><TextBlock Text="РАДАР" Foreground="{StaticResource MutedBrush}" FontSize="10" /><TextBlock Text="{Binding RadarTraderCount}" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel>
                </Border>
                <Border Background="{StaticResource CardBrush}" CornerRadius="8" Padding="13" Margin="0,0,8,0">
                    <StackPanel><TextBlock Text="БРОКЕР" Foreground="{StaticResource MutedBrush}" FontSize="10" /><TextBlock Text="{Binding BrokerTraderCount}" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel>
                </Border>
                <Border Background="{StaticResource CardBrush}" CornerRadius="8" Padding="13" Margin="0,0,8,0">
                    <StackPanel><TextBlock Text="ПРОДАЖА" Foreground="{StaticResource MutedBrush}" FontSize="10" /><TextBlock Text="{Binding SellCount}" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel>
                </Border>
                <Border Background="{StaticResource CardBrush}" CornerRadius="8" Padding="13" Margin="0,0,8,0">
                    <StackPanel><TextBlock Text="СКУПКА" Foreground="{StaticResource MutedBrush}" FontSize="10" /><TextBlock Text="{Binding BuyCount}" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel>
                </Border>
                <Border Background="{StaticResource CardBrush}" CornerRadius="8" Padding="13" Margin="0,0,8,0">
                    <StackPanel><TextBlock Text="ПАКЕТЫ" Foreground="{StaticResource MutedBrush}" FontSize="10" /><TextBlock Text="{Binding PackageCount}" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel>
                </Border>
                <Border Background="{StaticResource CardBrush}" CornerRadius="8" Padding="13" Margin="0,0,8,0">
                    <StackPanel><TextBlock Text="СТРОКИ" Foreground="{StaticResource MutedBrush}" FontSize="10" /><TextBlock Text="{Binding ListingCount}" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel>
                </Border>
                <Border Background="{StaticResource CardBrush}" CornerRadius="8" Padding="13">
                    <StackPanel><TextBlock Text="АКТОРЫ" Foreground="{StaticResource MutedBrush}" FontSize="10" /><TextBlock Text="{Binding ActorCount}" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel>
                </Border>
            </UniformGrid>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.25*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,14,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Радар рынка" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="  ● продажа" Foreground="{StaticResource PrimaryBrush}" FontSize="11" Margin="14,2,0,0" />
                                <TextBlock Text="● скупка" Foreground="#5EA8FF" FontSize="11" Margin="12,2,0,0" />
                                <TextBlock Text="● пакеты" Foreground="{StaticResource WarningBrush}" FontSize="11" Margin="12,2,0,0" />
                            </StackPanel>
                            <TextBlock Text="{Binding LastRadarLabel}" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                        </Grid>
                        <controls:RadarMapControl Grid.Row="1" Snapshot="{Binding Radar}" Margin="0,12,0,0" />
                    </Grid>
                </Border>
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Брокерный цикл" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding LastBrokerLabel}" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,12" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="70" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Интервал, минут" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding Profile.BrokerIntervalMinutes, UpdateSourceTrigger=PropertyChanged}" TextChanged="ProfileField_Changed" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="15">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock Text="События" FontSize="15" FontWeight="SemiBold" />
                            <ListBox Grid.Row="1" ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Events}"
                                     Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="-4,8,-4,8" />
                            <Button Grid.Row="2" Content="Удалить профиль" Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Left" Click="DeleteProfile_Click" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
