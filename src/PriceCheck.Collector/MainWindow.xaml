<Window x:Class="PriceCheck.Collector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PriceCheck.Collector.Controls"
        xmlns:views="clr-namespace:PriceCheck.Collector" xmlns:launchviews="clr-namespace:PriceCheck.Collector;assembly=PriceCheck.Launching.UI"
        Title="PriceCheck Collector — Сборщик" Width="1380" Height="840"
        MinWidth="1120" MinHeight="700" WindowStartupLocation="CenterScreen">
    <Grid Background="{StaticResource WindowBrush}" TextElement.Foreground="{StaticResource TextBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="286" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <launchviews:ProfileSidebarView x:Name="SidebarView" Grid.Column="0" ProductLabel="СБОРЩИК"
            AddProfileRequested="AddProfile_Click" DeleteProfileRequested="DeleteProfile_Click"
            TemplatesRequested="ManageTemplates_Click" ProfileSelected="SidebarProfileSelected"/>

        <TabControl x:Name="MainTabs" Grid.Column="1" Margin="20,12,20,18" Background="Transparent" BorderThickness="0"
                    SelectionChanged="MainTabs_SelectionChanged">
          <TabControl.Template>
           <ControlTemplate TargetType="TabControl">
            <ContentPresenter ContentSource="SelectedContent"/>
           </ControlTemplate>
          </TabControl.Template>
          <TabItem x:Name="ProfilesTab" Header="Профили">
           <TabControl x:Name="ProfileTabs" Background="Transparent" BorderThickness="0">
          <TabItem x:Name="LaunchTab" Header="Запуск"><launchviews:LaunchPanelView x:Name="LaunchPanel"
              AutoLoginChangedRequested="AutoLogin_Changed"
              BrowseFolderClickRequested="BrowseFolder_Click"
              LaunchClickRequested="Launch_Click"
              LaunchTemplateSelectionChangedRequested="LaunchTemplateSelection_Changed"
                LoginPasswordChangedRequested="LoginPassword_Changed"
                RotationAccountsClickRequested="RotationAccounts_Click"
              ManageTemplatesClickRequested="ManageTemplates_Click"
              ProfileFieldChangedRequested="ProfileField_Changed"
              ProfileSelectionChangedRequested="ProfileSelection_Changed"
              StopClickRequested="Stop_Click"
              /></TabItem>
          <TabItem Header="Сбор"><views:CollectionPanelView x:Name="CollectionPanel"
              ClearCenterZoneClickRequested="ClearCenterZone_Click"
              MarkCenterZoneClickRequested="MarkCenterZone_Click"
              ProfileFieldChangedRequested="ProfileField_Changed"
              ProfileSelectionChangedRequested="ProfileSelection_Changed"
              RoleDropDownClosedRequested="Role_DropDownClosed"
              ToggleCollectionClickRequested="ToggleCollection_Click"
              /></TabItem>

          <TabItem Header="Журнал"><views:JournalPanelView x:Name="JournalPanel"/></TabItem>
           </TabControl>
          </TabItem>
          <TabItem x:Name="TemplatesTab" Header="Шаблоны">
              <launchviews:LaunchTemplatesView x:Name="TemplatesView"/>
          </TabItem>
        </TabControl>
    </Grid>
</Window>
