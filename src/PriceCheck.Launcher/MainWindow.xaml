<Window x:Class="PriceCheck.Launcher.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:PriceCheck.Collector;assembly=PriceCheck.Launching.UI"
 Title="PriceCheck Launcher — Запуск" Width="1380" Height="840" MinWidth="1120" MinHeight="700" WindowStartupLocation="CenterScreen">
 <Grid Background="{StaticResource WindowBrush}" TextElement.Foreground="{StaticResource TextBrush}">
  <Grid.ColumnDefinitions><ColumnDefinition Width="286"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <views:ProfileSidebarView x:Name="SidebarView" Grid.Column="0" ProductLabel="ЛАУНЧЕР"
   AddProfileRequested="AddProfile_Click" DeleteProfileRequested="DeleteProfile_Click"
   TemplatesRequested="ManageTemplates_Click" ProfileSelected="SidebarProfileSelected"/>
  <TabControl x:Name="MainTabs" Grid.Column="1" Margin="20,12,20,18" Background="Transparent" BorderThickness="0"
              SelectionChanged="MainTabs_SelectionChanged">
   <TabControl.Template>
    <ControlTemplate TargetType="TabControl">
     <ContentPresenter ContentSource="SelectedContent"/>
    </ControlTemplate>
   </TabControl.Template>
   <TabItem x:Name="ProfilesTab" Header="Профили">
    <TabControl x:Name="ProfileTabs" Background="Transparent" BorderThickness="0">
   <TabItem x:Name="LaunchTab" Header="Запуск">
    <views:AccountLaunchPanelView x:Name="LaunchPanel"
     AddAccountRequested="AddAccount_Click" EditAccountRequested="EditAccount_Click"
     DeleteAccountRequested="DeleteAccount_Click" LaunchAccountRequested="LaunchAccount_Click"
     StopAccountRequested="StopAccount_Click" BrowseFolderRequested="BrowseFolder_Click"
     ManageTemplatesRequested="ManageTemplates_Click" ProfileFieldChangedRequested="AccountLaunchFile_Changed"/>
   </TabItem>
   <TabItem Header="Журнал">
    <Grid Margin="8,10">
     <Grid.Resources><views:RussianUiTextConverter x:Key="RussianText"/></Grid.Resources>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12">
      <Run Text="Журнал · "/><Run Text="{Binding SelectedRuntime.Profile.Name}"/>
     </TextBlock>
     <ListBox Grid.Row="1" ItemsSource="{Binding ProfileEvents}"
       Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
      <ListBox.ItemTemplate>
       <DataTemplate>
        <StackPanel Orientation="Horizontal" Margin="4,3">
         <TextBlock Text="{Binding Time, StringFormat={}{0:HH:mm:ss}}" Foreground="{StaticResource MutedBrush}" Margin="0,0,12,0"/>
         <TextBlock Text="{Binding Message, Converter={StaticResource RussianText}}" TextWrapping="Wrap"/>
        </StackPanel>
       </DataTemplate>
      </ListBox.ItemTemplate>
     </ListBox>
    </Grid>
   </TabItem>
    </TabControl>
   </TabItem>
   <TabItem x:Name="TemplatesTab" Header="Шаблоны"><views:LaunchTemplatesView x:Name="TemplatesView"/></TabItem>
  </TabControl>
 </Grid>
</Window>
